# Global ARCHitecture settings for the Sample code
#
# this file should be adapted to your platform

# Target CPU
CPU	= x64
#CPU =x86

# Target OS
OS	    = OSX

# OS-X version
OSXV	= -mmacosx-version-min=10.5
# architecture flags
#ARCH	= -m32

# compilation flags
OPT	    = -O3 $(ARCH) $(OSXV)
# compiler version
CVER    = 4.2
# compiler
CC	    = g++-$(CVER)
# linker
LD	    = ld
AR	    = ar

# some flags
#DFLAGS	= -D_$(CPU) -D_$(OS) -D__BIG_ENDIAN__
DFLAGS	= -D_$(CPU) -D_$(OS)
FLAGS   = -fexceptions -I/usr/include $(DFLAGS)

## few locations
INC_DIR	= ../../inc-pc
BIN_DIR = ../../bin-pc/$(CPU)
LIB_DIR = ../../lib-pc/$(CPU)/$(CVER)
OBJ_DIR	= ./obj/$(CPU)
